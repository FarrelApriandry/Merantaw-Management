# Salin ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
# Format: KEY=value TANPA spasi di sekitar '='.

# --- Neon Postgres (wajib) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
NEON_BRANCH=production

# --- better-auth (wajib) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# --- Inbox Gmail IMAP (opsional; tanpa ini /api/inbox balas 503) ---
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# Service token untuk pemanggil non-browser (opsional). Browser pakai cookie session.
INBOX_API_TOKEN=
